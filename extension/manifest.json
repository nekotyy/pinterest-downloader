{
  "manifest_version": 3,
  "name": "Pinterest Download — вкладки",
  "version": "1.1.0",
  "description": "Передаёт открытые пины в локальное приложение Pinterest Download.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "http://127.0.0.1:17849/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pinterest Download",
    "default_icon": {
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "author": "nekoty developer",
  "icons": {
    "128": "icon128.png"
  }
}