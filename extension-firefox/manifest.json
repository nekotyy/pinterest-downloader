{
  "manifest_version": 3,
  "name": "Pinterest Download — вкладки",
  "version": "1.0.0",
  "description": "Передаёт открытые пины в локальное приложение Pinterest Download.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "http://127.0.0.1:17849/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Обновить пины в Pinterest Download"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pinterest-download@nekotyy.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}