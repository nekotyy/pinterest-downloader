{
  "manifest_version": 3,
  "name": "Pinterest Downloader: вкладки",
  "version": "1.2.0",
  "description": "Передаёт открытые пины в локальное приложение Pinterest Downloader.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "http://127.0.0.1:17849/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Pinterest Downloader",
    "default_icon": {
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pinterest-download@nekotyy.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "author": "nekoty developer",
  "icons": {
    "128": "icon128.png"
  }
}
